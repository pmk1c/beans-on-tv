// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
  "name": "beans-on-tv",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": { "configureZshAsDefaultShell": true },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/ripgrep:1": {}
  },
  "forwardPorts": [8081, 5432],
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.expo/state.json,target=/home/vp/.expo/state.json,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/vp/.gitconfig,type=bind",
    "source=${localEnv:SSH_AUTH_SOCK},target=/home/vp/.ssh-agent,type=bind"
  ],
  "postCreateCommand": {
    "install packages": "vp i",
    "install eas-cli": "vp i -g eas-cli",
    "fix permissions": "chown vp:vp /home/vp/.ssh-agent"
  },
  "customizations": {
    "vscode": {
      "extensions": ["VoidZero.vite-plus-extension-pack", "Prisma.prisma"]
    },
    "zed": {
      "extensions": ["oxc", "prisma"]
    }
  },
  "containerEnv": {
    "NODE_ENV": "development",
    "SSH_AUTH_SOCK": "/home/vp/.ssh-agent"
  },
  "remoteUser": "vp"
}
